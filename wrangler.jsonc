{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openworkspace",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/.well-known/*", "/oauth/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MAILBOX",
        "class_name": "MailboxDO"
      }
    ]
  },
  "exports": {
    "MailboxDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openworkspace",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_STORAGE",
      "bucket_name": "openworkspace"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUSH_NOTIFICATIONS",
        "queue": "openworkspace-push-notifications"
      },
      {
        "binding": "WEBHOOKS",
        "queue": "openworkspace-webhooks"
      }
    ],
    "consumers": [
      {
        "queue": "openworkspace-delivery-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5
      },
      {
        "queue": "openworkspace-push-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5
      },
      {
        "queue": "openworkspace-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5
      }
    ]
  },
  "vars": {
    "SESSION_TTL_DAYS": "30"
  }
}
