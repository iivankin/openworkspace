{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openworkspace-test",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "MAILBOX",
        "class_name": "MailboxDO"
      }
    ]
  },
  "exports": {
    "MailboxDO": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openworkspace-test",
      "database_id": "local-test",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_STORAGE",
      "bucket_name": "openworkspace-test"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUSH_NOTIFICATIONS",
        "queue": "openworkspace-push-notifications-test"
      }
    ],
    "consumers": [
      {
        "queue": "openworkspace-delivery-events-test"
      },
      {
        "queue": "openworkspace-push-notifications-test"
      }
    ]
  },
  "vars": {
    "SESSION_TTL_DAYS": "30"
  }
}
