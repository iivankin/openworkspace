# Deploy to Cloudflare prompts for every UNCOMMENTED entry as a Worker secret.
# Keep local-only and optional values commented so production is not pre-filled.

# Local only — never set in production. Uncomment for `bun run dev`:
# ALLOW_MOCK_AUTH=true

# Optional identity providers. OIDC and SAML always use the same public origin:
# IDENTITY_PROVIDER_ORIGIN=https://mail.example.com
# Set it once after deploy:
#   wrangler secret put IDENTITY_PROVIDER_ORIGIN

# Optional OIDC IdP. Generate with `bun run oidc:keygen`, then:
#   wrangler secret put OIDC_SIGNING_PRIVATE_JWK
# OIDC_SIGNING_PRIVATE_JWK=

# Optional SAML IdP. Generate a PEM key and certificate with:
#   bun run saml:keygen
#   wrangler secret put SAML_SIGNING_PRIVATE_KEY < .saml/private-key.pem
#   wrangler secret put SAML_SIGNING_CERTIFICATE < .saml/certificate.pem
# SAML_SIGNING_PRIVATE_KEY=
# SAML_SIGNING_CERTIFICATE=
# SAML_ADDITIONAL_SIGNING_CERTIFICATES=

# Optional R2 S3 API tokens for direct attachment transfers (presigned GET/PUT).
# Without these, uploads fall back to the Worker. Create an R2 API token with
# Object Read & Write on the mail bucket, then:
#   wrangler secret put R2_ACCESS_KEY_ID
#   wrangler secret put R2_SECRET_ACCESS_KEY
#   wrangler secret put R2_ACCOUNT_ID
# R2_BUCKET_NAME defaults to openworkspace when unset.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=openworkspace

# Optional authentication summary in Show original. Set an Analytics Read token
# here, then enter each mail domain's Zone ID in Administration → Domains.
# Cloudflare Email Routing analytics are retained for 31 days.
# CLOUDFLARE_ANALYTICS_TOKEN=

# Optional Web Push. Generate one persistent key pair with
# `bun run push:keygen`, expose the public key as a regular Worker variable,
# and keep the private key as a secret in production.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
