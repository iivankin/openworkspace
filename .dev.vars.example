# Deploy to Cloudflare prompts for every UNCOMMENTED entry as a Worker secret.
# Keep local-only and optional values commented so production is not pre-filled.

# Local only — never set in production. Uncomment for `bun run dev`:
# ALLOW_MOCK_AUTH=true

# Optional OIDC IdP. Set after deploy (see README), not via Deploy button defaults:
# OIDC_ISSUER=https://mail.example.com
# Generate with `bun run oidc:keygen`, then:
#   wrangler secret put OIDC_ISSUER
#   wrangler secret put OIDC_SIGNING_PRIVATE_JWK
# OIDC_SIGNING_PRIVATE_JWK=

# Optional R2 S3 API tokens for direct browser attachment uploads (presigned PUT).
# Without these, uploads fall back to the Worker. Create an R2 API token with
# Object Read & Write on the mail bucket, then:
#   wrangler secret put R2_ACCESS_KEY_ID
#   wrangler secret put R2_SECRET_ACCESS_KEY
#   wrangler secret put R2_ACCOUNT_ID
# R2_BUCKET_NAME defaults to openworkspace when unset.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=openworkspace

# Optional Web Push. Generate one persistent key pair with
# `bun run push:keygen`, expose the public key as a regular Worker variable,
# and keep the private key as a secret in production.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
