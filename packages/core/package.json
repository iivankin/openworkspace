{
  "name": "@open-workspace/core",
  "version": "0.4.2",
  "description": "OpenWorkspace: a self-hosted workspace on your own Cloudflare account. Identity, SSO, administration, and the module host.",
  "keywords": [
    "alchemy",
    "cloudflare",
    "email",
    "oidc",
    "saml",
    "scim",
    "self-hosted",
    "sso",
    "workers"
  ],
  "homepage": "https://openworkspace.dev",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iivankin/openworkspace.git",
    "directory": "packages/core"
  },
  "files": [
    "alchemy",
    "worker",
    "shared",
    "migrations",
    "src",
    "dev",
    "testing",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./worker/index.ts",
    "./alchemy": "./alchemy/index.ts",
    "./module": "./worker/module-api.ts",
    "./shared": "./shared/index.ts",
    "./ui": "./src/ui.ts",
    "./theme.css": "./src/theme.css",
    "./dev": "./dev/stack.ts",
    "./testing": "./testing/index.ts",
    "./testing/worker": "./testing/worker.ts",
    "./testing/e2e": "./testing/e2e.ts"
  },
  "scripts": {
    "build": "bun alchemy/client.ts",
    "dev": "ALLOW_MOCK_AUTH=true alchemy dev dev/alchemy.run.ts",
    "test": "bun run test:unit && bun run test:stack",
    "test:unit": "bun test ./test/unit",
    "test:stack": "bun test --preload ./test/stack/setup.ts --timeout 60000 ./test/stack",
    "test:e2e": "playwright test -c test/e2e --project=desktop && playwright test -c test/e2e --project=mobile",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && tsc -p test/e2e/tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.102",
    "@ai-sdk/google": "4.0.114",
    "@ai-sdk/openai": "4.0.111",
    "@ai-sdk/openai-compatible": "3.0.90",
    "@ai-sdk/provider": "4.0.37",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@peculiar/asn1-schema": "3.0.0",
    "@peculiar/x509": "3.1.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.107.1",
    "@vitejs/plugin-react": "6.3.0",
    "@xmldom/xmldom": "0.9.12",
    "agents": "0.33.0",
    "ai": "7.0.166",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "jose": "6.2.17",
    "lucide-react": "1.71.0",
    "oxc-transform-react": "0.156.0",
    "react": "19.3.1",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "reflect-metadata": "0.2.2",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.7",
    "xml-crypto": "6.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/test": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.3",
    "@effect/platform-node": "4.1.3",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "alchemy": "2.0.0-beta.85",
    "drizzle-kit": "0.31.11",
    "effect": "4.1.3",
    "playwright": "1.65.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/test": "2.0.0-beta.85",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.3"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/test": {
      "optional": true
    }
  }
}
